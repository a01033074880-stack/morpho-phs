    "chirality": 0.9,
    "nonlinear": 0.6,
    "hq": 0.7,
    "decay": 0.9,
    "life": 0.0,
    "morph": 0.3,
    "tau": 0.0833,
    "freeze": 0.0,
    "wet": 0.85,
    "dry": 0.0,
    "in_gain": 0.0,
    "out_gain": 11.0,
    "spread": 0.25,
    "exciter": "Pluck",
    "defect_depth": 0.6,
    "macro1": 0.6544,
    "macro2": 0.95,
    "macro3": 0.6,
    "macro4": 0.8955,
    "macro5": 0.0,
    "macro6": 0.6695,
    "macro7": 0.6667,
    "macro8": 0.5,
    "edge_width": 1.0,
    "edge_crosstalk": 0.0
  },
  "macros": {
    "names": [
      "Brightness",
      "Twist",
      "Body",
      "Sustain",
      "Life",
      "Morph Speed",
      "Grit",
      ""
    ],
    "targets": [
      {
        "macro": 1,
        "param": "tone",
        "lo": 800,
        "hi": 3000
      },
      {
        "macro": 2,
        "param": "chirality",
        "lo": -1.0,
        "hi": 1.0
      },
      {
        "macro": 3,
        "param": "defect_depth",
        "lo": 0.0,
        "hi": 1.0
      },
      {
        "macro": 4,
        "param": "decay",
        "lo": 0.3,
        "hi": 0.97
      },
      {
        "macro": 5,
        "param": "life",
        "lo": 0.0,
        "hi": 0.5
      },
      {
        "macro": 6,
        "param": "tau",
        "lo": 1.5,
        "hi": 0.02
      },
      {
        "macro": 7,
        "param": "nonlinear",
        "lo": 0.0,
        "hi": 0.9
      },
      {
