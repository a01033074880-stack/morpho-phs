{
  "format": "morpho-phs-preset",
  "version": 2,
  "name": "Metal Lattice",
  "category": "Inst Plucked",
  "author": "MORPHO-PHS factory",
  "description": "HQ log-cosh potential plus high nonlinearity: metallic, inharmonic plucks.",
  "params": {
    "mode": "Instrument",
    "lattice": "16x16",
