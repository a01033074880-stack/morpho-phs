        "lo": 0.8,
        "hi": 0.2
      },
      {
        "macro": 4,
        "param": "decay",
        "lo": 0.2,
        "hi": 0.95
      },
      {
        "macro": 5,
        "param": "morph",
        "lo": 0.0,
        "hi": 0.9
      },
      {
        "macro": 5,
        "param": "tau",
        "lo": 0.5,
        "hi": 0.05
      },
