{
  "format": "morpho-phs-preset",
  "version": 2,
  "name": "Breathing Edge",
  "category": "FX Edge",
  "author": "MORPHO-PHS factory",
  "description": "Morphogen waves flip the local chirality, so the edge path opens and closes over time.",
  "params": {
    "mode": "FX Edge Disperser",
